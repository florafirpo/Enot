# Copiar este archivo como .env y completar. El .env NO se sube a git.

# Región (se usa en el prompt de extracción)
REGION_NOMBRE=Borgoña (Bourgogne, Francia)

# Google Places API (New) — solo para el camino alternativo `seed` (no hace falta con DATAtourisme)
GOOGLE_MAPS_API_KEY=

# Mail de contacto que va en el User-Agent del crawler (buena práctica de scraping)
CONTACT_EMAIL=

# LLM para la extracción — paso 4
# LLM_PROVIDER: openai | anthropic | openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Solo para openai_compatible (Ollama local, OpenRouter, Groq...). Ejemplo Ollama:
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
OPENAI_BASE_URL=

# Cuánto texto por bodega se le manda al LLM como máximo
MAX_CHARS_POR_BODEGA=60000
